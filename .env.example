# VaiVota — MVP Semana Tech. Copie para `.env.local` (desenvolvimento) ou cadastre as mesmas variáveis na Vercel
# (Settings > Environment Variables). Passo a passo completo: docs/SEMANA-TECH-IMPLANTACAO.md.
# Nunca coloque segredos em variáveis NEXT_PUBLIC_* (elas vão para o navegador).

# ─────────────────────────────────────────────────────────────────────────────
# Banco (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Conexão da APLICAÇÃO: o pooler do Supabase (Project Settings > Database > Connection string > "Transaction pooler",
# porta 6543). A Vercel é serverless e não pode abrir uma conexão direta por requisição.
DATABASE_URL=
# Conexão para MIGRAR e fazer backup: o "Session pooler" (porta 5432, funciona em IPv4). A "Direct connection"
# (db.xxxx.supabase.co) só tem IPv6 no plano gratuito e falha em muitas redes.
DIRECT_URL=
# Conexões por instância da aplicação (opcional; padrão 5).
# DB_POOL_MAX=5

# ─────────────────────────────────────────────────────────────────────────────
# Site e autenticação (Better Auth)
# ─────────────────────────────────────────────────────────────────────────────
# URL pública do site, sem barra no fim. É a origem confiável do login e vai nos links.
# Em produção: o domínio final (ex.: https://votacao.seudominio.space).
APP_URL=
# Segredo da autenticação: gere com `openssl rand -base64 32` (mínimo de 32 caracteres). Trocar invalida as sessões.
BETTER_AUTH_SECRET=
# Outras origens aceitas, separadas por vírgula (ex.: o endereço *.vercel.app ao lado do domínio próprio). Opcional.
TRUSTED_ORIGINS=
# Se definido, a raiz do site (/) leva direto para /e/<slug>. Para a Semana Tech: semana-tech.
# EVENTO_PADRAO_SLUG=semana-tech

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web").
# Origem autorizada: APP_URL. URI de redirecionamento: APP_URL/api/auth/callback/google. Publique o app (fora do modo de teste).
# Sem estas duas, o botão do Google some e o evento fica só com e-mail e senha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (códigos de verificação e de recuperação de senha)
# ─────────────────────────────────────────────────────────────────────────────
# resend (principal) | smtp (plano B: Gmail com senha de app) | console (só desenvolvimento: imprime o código no log).
# Sem EMAIL_PROVIDER: usa o Resend se houver RESEND_API_KEY; em produção, sem chave, é erro (ninguém receberia o código).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Remetente com o nome do evento, num domínio VERIFICADO no Resend (SPF/DKIM), ex.: mail.seudominio.space.
# O remetente de teste onboarding@resend.dev só entrega para o dono da conta e NÃO serve para o evento.
EMAIL_FROM=Semana Tech <votacao@mail.vaivota.space>
# Plano B (EMAIL_PROVIDER=smtp). Gmail: host smtp.gmail.com, porta 465, usuário = o e-mail, senha = senha de app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# Imagens dos candidatos (Supabase Storage)
# ─────────────────────────────────────────────────────────────────────────────
# URL do projeto (Project Settings > API > Project URL) e a chave de serviço (service_role: SÓ no servidor, nunca no navegador).
# SUPABASE_URL precisa existir também no BUILD (libera o domínio das imagens no next/image).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público para leitura (o seed cria se não existir). Padrão: candidatos.
# SUPABASE_STORAGE_BUCKET=candidatos
# Desenvolvimento sem Supabase: grava em public/uploads. Em produção só vale se pedido aqui de propósito.
# STORAGE_PROVIDER=local

# ─────────────────────────────────────────────────────────────────────────────
# Seed e operação
# ─────────────────────────────────────────────────────────────────────────────
# Dados do evento criado por `pnpm db:seed` (todos opcionais; ISO 8601 com offset). Rodar de novo não desfaz nada.
# SEED_SLUG=semana-tech
# SEED_NOME=Semana Tech
# SEED_JANELA_INICIO=2026-10-19T08:00:00-03:00
# SEED_JANELA_FIM=2026-10-19T22:00:00-03:00
# Sal do hash do IP gravado na auditoria (padrão: BETTER_AUTH_SECRET).
# IP_HASH_SALT=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoramento (Sentry) — opcional; sem DSN, nada é enviado
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Festival (fora do MVP da Semana Tech): júri, voto infantil, totem, modo apresentação e galeria de dev.
# Desligado (padrão), essas rotas dão 404 e os atalhos somem. Embutida no build.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_MODULOS_FESTIVAL=false