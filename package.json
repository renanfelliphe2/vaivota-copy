{
  "name": "vaivota",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "db:migrar": "prisma migrate deploy",
    "db:migrar:dev": "prisma migrate dev",
    "db:gerar": "prisma generate",
    "db:seed": "tsx --conditions=react-server scripts/semear.ts",
    "db:promover-admin": "tsx --conditions=react-server scripts/promover-admin.ts",
    "db:limpar-ensaio": "tsx --conditions=react-server scripts/limpar-ensaio.ts",
    "db:backup": "tsx --conditions=react-server scripts/backup.ts",
    "db:local": "tsx --conditions=react-server scripts/banco-local.ts",
    "db:carga-preparar": "tsx --conditions=react-server scripts/carga-preparar.ts",
    "db:carga-conferir": "tsx --conditions=react-server scripts/carga-conferir.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.8",
    "lucide-react": "1.52.0",
    "next": "16.3.5",
    "nodemailer": "^10.1.0",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "embedded-postgres": "17.5.0-beta.15",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
